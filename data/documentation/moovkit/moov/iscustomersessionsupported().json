{"sections":[],"metadata":{"platforms":[{"introducedAt":"17.0","unavailable":false,"deprecated":false,"name":"iOS","beta":false},{"introducedAt":"17.0","unavailable":false,"deprecated":false,"name":"iPadOS","beta":false},{"introducedAt":"17.0","unavailable":false,"deprecated":false,"name":"Mac Catalyst","beta":false}],"symbolKind":"method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCustomerSessionSupported","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Method","extendedModule":"MoovKit","title":"isCustomerSessionSupported()","externalID":"s:7MoovKit0A0C26isCustomerSessionSupportedSbyF","modules":[{"name":"MoovKit"}]},"abstract":[{"text":"Returns true if this device can run a Tap to Share session.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCustomerSessionSupported"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]}]},{"kind":"mentions","mentions":["doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Tap-to-Share"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Unlike the rest of the Tap to Share API this method is callable on every iOS version the SDK","type":"text"},{"text":" ","type":"text"},{"text":"supports, so an existing integration can branch on it without an ","type":"text"},{"code":"#available","type":"codeVoice"},{"text":" check of its","type":"text"},{"text":" ","type":"text"},{"text":"own. It returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" on anything earlier than iOS 27.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This reports device and OS capability only, and can return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" where a real session still"},{"type":"text","text":" "},{"type":"text","text":"cannot be opened. Tap to Share requires iPhone 12 or later, a stricter requirement than Tap"},{"type":"text","text":" "},{"type":"text","text":"to Pay on iPhone, and there is no API to detect the model. It also returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"simulator, where "},{"type":"codeVoice","code":"PaymentCardReader.isSupported"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no reader hardware exists. In"},{"type":"text","text":" "},{"type":"text","text":"both cases "},{"isActive":true,"type":"reference","identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov\/createCustomerSession(configuration:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/CustomerSessionError\/notSupported"},{"type":"text","text":", so treat that as the authoritative answer and keep a"},{"type":"text","text":" "},{"type":"text","text":"fallback payment path."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Test mode is unaffected: a sandbox session opens and runs anywhere, including the simulator.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/moovkit\/moov\/iscustomersessionsupported()"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/io.moov.MoovKit\/documentation\/MoovKit","doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov"]]},"identifier":{"url":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov\/isCustomerSessionSupported()","interfaceLanguage":"swift"},"references":{"doc://io.moov.MoovKit/documentation/Moov