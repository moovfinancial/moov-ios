raph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if the Apple Pay sheet was presented. ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":" if the customer chose a"},{"type":"text","text":" "},{"type":"text","text":"non-Apple Pay option or hasn’t set up Apple Pay, in which case fall back to another"},{"type":"text","text":" "},{"type":"text","text":"payment method such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov\/createTapAuthorization(for:transactionType:customerAccountId:)"},{"type":"text","text":"."}]}]},{"kind":"mentions","mentions":["doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Tap-to-Share"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple only displays the Apple Pay option against a cart that was shared with the customer,"},{"type":"text","text":" "},{"type":"text","text":"so pass the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/ShoppingCartToken"},{"type":"text","text":" returned by the most recent call to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov\/updateShoppingCart(_:)"},{"type":"text","text":". Check "},{"type":"reference","isActive":true,"identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov\/customerClientType"},{"type":"text","text":" first: only a customer on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/CustomerClientType\/localWireless"},{"type":"text","text":" is on a compatible iOS version."}]},{"inlineContent":[{"type":"text","text":"The SDK presents the sheet and forwards authorization to "},{"code":"delegate","type":"codeVoice"},{"text":"; it does not process the","type":"text"},{"text":" ","type":"text"},{"text":"resulting ","type":"text"},{"code":"PKPayment","type":"codeVoice"},{"text":". Send that payment to your backend and link it with Moov’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/accounts\/{accountID}\/apple-pay\/tokens","type":"codeVoice"},{"text":" endpoint, which accepts the same","type":"text"},{"text":" ","type":"text"},{"code":"paymentData","type":"codeVoice"},{"type":"text","text":" blob as Apple Pay on the Web."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A payment token is encrypted to the payment processing certificate of the merchant"},{"type":"text","text":" "},{"type":"text","text":"identifier in "},{"type":"codeVoice","code":"paymentRequest"},{"type":"text","text":", so for Moov to decrypt it, set"},{"text":" ","type":"text"},{"type":"codeVoice","code":"paymentRequest.isDelegatedRequest = true"},{"text":" and present on behalf of the Moov merchant.","type":"text"},{"text":" ","type":"text"},{"text":"That requires the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.in-app-payments-delegate"},{"text":" entitlement and your app","type":"text"},{"text":" ","type":"text"},{"text":"to be registered as an Apple Pay delegate. Without it, Apple encrypts to a certificate","type":"text"},{"text":" ","type":"text"},{"text":"Moov doesn’t hold and the token can’t be processed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that Moov doesn’t offer Apple Pay in test mode, and sandbox mode always reports","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":" from this method."}],"type":"paragraph"}]}],"sections":[],"abstract":[{"text":"Asks the customer to pay for a shared cart with Apple Pay on their own iPhone.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/io.moov.MoovKit\/documentation\/MoovKit","doc:\/\/io.moov.MoovKit\/documentation\/MoovKit\/Moov"]]},"kind":"symbol","identifier":